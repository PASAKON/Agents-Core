# Thin shim — lets claudesign daemon spawn the bridge as a "binary" without
# having to know our virtualenv path. PATH-detection (`which claude`) inside
# the Python bridge picks up the real claude CLI from the user's shell PATH.
exec /Users/gob/MoonieXHQ/Agents/Core/.venv/bin/python \
  /Users/gob/MoonieXHQ/Agents/Core/tools/claudesign_tmux_bin.py "$@"

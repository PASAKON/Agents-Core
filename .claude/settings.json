{
  "permissionMode": "auto",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/session-deadline-check.py",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/hook-log-prompt.py"
          },
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/hook-recall.py"
          },
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/hook-skill-suggest.py"
          },
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/hook-memory-nudge.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/hook-browser-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/hook-self-repo-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/hook-skill-log.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/gob/Projects/Agents/scripts/hook-log-reply.py"
          }
        ]
      }
    ]
  }
}

{
  "permissionMode": "auto",
  "permissions": {
    "allow": [
      "Bash(./scripts/winbox-line-send.sh:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/session-deadline-check.py",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-cache-cold-warn.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-log-prompt.py"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-recall.py"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-skill-suggest.py"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-memory-nudge.py"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-inbox.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-browser-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-self-repo-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Skill|mcp__claude_ai_Google_Drive__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-gdrive-skill-gate.py"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|mcp__org__wiki_search|Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-research-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-cwd-guard.py"
          }
        ]
      },
      {
        "matcher": "Read|mcp__claude-in-chrome__computer|mcp__claude-in-chrome__browser_batch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-image-budget.py"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-log-reply.py"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hook-phone-only-commands.py"
          }
        ]
      }
    ]
  }
}

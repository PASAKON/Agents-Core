  "segments": [
    {
      "id": "seg01",
      "t0": 0.0,
      "t1": 39.3,
      "frame_count": 1179,
      "lines": [
        {
          "tag": "HOOK-1",
          "t0": 0.18,
          "t1": 2.64,
          "text": "ใครใช้โบรกนี้อยู่ รีบเข้าเว็บไปเช็กด่วนเลย"
        },
        {
          "tag": "HOOK-2",
          "t0": 3.08,
          "t1": 5.54,
          "text": "ตอนนี้แม่งปิดเว็บ เข้าไม่ได้แล้ว"
        },
        {
          "tag": "HOOK-3",
          "t0": 5.54,
          "t1": 7.38,
          "text": "นี่คือหลักฐานตอนที่กูพยายามเข้าเว็บ"
        },
        {
          "tag": "HOOK-4",
          "t0": 7.82,
          "t1": 10.86,
          "text": "โบรกตัวนี้ชื่อ เอ็กซ์เอ็กซ์แอลมาร์เก็ตส์ มึงดูภาพเอาเอง"
        },
        {
          "tag": "PATTERN-1",
          "t0": 11.4,
          "t1": 17.86,
          "text": "เป็นโบรกฟอเร็กซ์ ที่วิกิเอฟเอ็กซ์บอกว่าเปิดที่อังกฤษตั้งแต่ปีสองพันยี่สิบเอ็ด ให้เทรดทั้งค่าเงิน หุ้น และสินค้า"
        },
        {
          "tag": "PATTERN-2",
          "t0": 18.48,
          "t1": 22.42,
          "text": "กูลองพิมพ์ชื่อเว็บนี้ใส่เบราว์เซอร์ตรงๆ หน้าเว็บขึ้นว่าเข้าไม่ได้"
        },
        {
          "tag": "PATTERN-3",
          "t0": 22.8,
          "t1": 27.78,
          "text": "ลองอีกทาง ใส่ www นำหน้าบ้าง ใส่ https ตรงๆบ้าง"
        },
        {
          "tag": "PATTERN-4",
          "t0": 28.26,
          "t1": 30.78,
          "text": "ผลเหมือนเดิมทุกครั้ง เข้าไม่ได้"
        },
        {
          "tag": "CONTEXT-1",
          "t0": 31.3,
          "t1": 35.44,
          "text": "กูไม่เชื่อว่าแค่เว็บล่มเฉยๆ เลยลองเช็กว่าใครเป็นเจ้าของชื่อเว็บนี้"
        },
        {
          "tag": "CONTEXT-2",
          "t0": 36.12,
          "t1": 38.86,
          "text": "เข้าเว็บเช็กชื่อเว็บฟรีๆ พิมพ์ชื่อเว็บนี้ลงไป"
        }
      ]
    },
    {
      "id": "seg02",
      "t0": 39.3,
      "t1": 65.8333,
      "frame_count": 796,
      "lines": [
        {
          "tag": "CONTEXT-3",
          "t0": 39.66,
          "t1": 43.16,
          "text": "เจอเลย ไม่มีใครเป็นเจ้าของชื่อเว็บนี้แล้วตอนนี้"
        },
        {
          "tag": "CONTEXT-4",
          "t0": 43.9,
          "t1": 47.72,
          "text": "แต่เจอประวัติว่าเคยมีเจ้าของ ย้อนไปถึงปีสองพันยี่สิบสอง"
        },
        {
          "tag": "CONTEXT-5",
          "t0": 48.5,
          "t1": 54.22,
          "text": "หน้าเดียวกันนี้มีตัวนับให้ดูชัดๆอีกด้วย สี่ครั้งตั้งแต่สองพันยี่สิบสองถึงสองพันยี่สิบหก"
        },
        {
          "tag": "MAIN-1",
          "t0": 54.84,
          "t1": 58.3,
          "text": "กูเลยลองไปดูที่วิกิเอฟเอ็กซ์ เว็บที่เช็กโบรกทั่วโลก"
        },
        {
          "tag": "MAIN-2",
          "t0": 58.3,
          "t1": 61.84,
          "text": "วิกิเอฟเอ็กซ์เขียนไว้เองเหมือนกันว่าเว็บนี้เข้าไม่ได้ตามปกติ"
        },
        {
          "tag": "MAIN-3",
          "t0": 62.32,
          "t1": 65.44,
          "text": "แปลว่าไม่ใช่กูคนเดียวที่เข้าไม่ได้ วิกิเอฟเอ็กซ์ก็เจอเหมือนกัน"
        }
      ]
    },
    {
      "id": "seg03",
      "t0": 65.8333,
      "t1": 104.5333,
      "frame_count": 1161,
      "lines": [
        {
          "tag": "MAIN-4",
          "t0": 66.12,
          "t1": 68.32,
          "text": "เช็กต่อว่ามีใบอนุญาตซื้อขายฟอเร็กซ์ไหม"
        },
        {
          "tag": "MAIN-5",
          "t0": 69.04,
          "t1": 70.88,
          "text": "ไม่พบใบอนุญาตซื้อขายฟอเร็กซ์เลย"
        },
        {
          "tag": "MAIN-6",
          "t0": 71.44,
          "t1": 73.08,
          "text": "เช็กเรื่องหน่วยงานกำกับดูแลต่อ"
        },
        {
          "tag": "MAIN-7",
          "t0": 73.32,
          "t1": 76.06,
          "text": "เจอคำเตือนว่ายังไม่มีการกำกับดูแลที่ถูกต้องจริงๆ"
        },
        {
          "tag": "MAIN-8",
          "t0": 76.36,
          "t1": 79.92,
          "text": "คะแนนความน่าเชื่อถือที่วิกิเอฟเอ็กซ์ให้ อยู่ที่หนึ่งจุดเก้าเก้าจากสิบ"
        },
        {
          "tag": "MAIN-9",
          "t0": 80.26,
          "t1": 83.08,
          "text": "จดทะเบียนที่สหราชอาณาจักร เปิดมาแค่สองถึงห้าปี"
        },
        {
          "tag": "MAIN-10",
          "t0": 83.4,
          "t1": 86.58,
          "text": "แล้วเจอคำเตือนอีกอัน ใบอนุญาตกำลังถูกตั้งข้อสงสัย"
        },
        {
          "tag": "MAIN-11",
          "t0": 86.84,
          "t1": 88.86,
          "text": "กลุ่มธุรกิจก็ถูกจัดว่าน่าสงสัยเหมือนกัน"
        },
        {
          "tag": "MAIN-12",
          "t0": 89.32,
          "t1": 93.24,
          "text": "กูลองเช็กหน่วยงานการเงินของอังกฤษเองด้วย แต่หน้าเว็บโหลดผลไม่ขึ้นเลย"
        },
        {
          "tag": "MAIN-13",
          "t0": 93.64,
          "t1": 97.2,
          "text": "กูไม่ได้บอกว่าเจ้านี้โกงแน่นอน กูแค่พาไปดูของจริงที่เช็กเจอ"
        },
        {
          "tag": "CURIOSITY-1",
          "t0": 97.64,
          "t1": 100.16,
          "text": "นี่คือการ์ดที่วิกิเอฟเอ็กซ์เขาสรุปเรื่องนี้ไว้เองเลย"
        },
        {
          "tag": "CURIOSITY-2",
          "t0": 100.6,
          "t1": 104.28,
          "text": "คะแนนย่อยแทบทุกด้านก็แย่เหมือนกัน ทั้งกำกับดูแลและความเสี่ยง"
        }
      ]
    },
    {
      "id": "seg04",
      "t0": 104.5333,
      "t1": 145.9,
      "frame_count": 1241,
      "lines": [
        {
          "tag": "CURIOSITY-3",
          "t0": 104.74,
          "t1": 108.24,
          "text": "วิกิเอฟเอ็กซ์เขียนไว้ด้วยว่าหน่วยงานการเงินของอังกฤษไม่พบข้อมูลเจ้านี้เหมือนกัน"
        },
        {
          "tag": "CURIOSITY-4",
          "t0": 108.24,
          "t1": 114.22,
          "text": "อันนี้ไม่ใช่กูพูดเอง วิกิเอฟเอ็กซ์เขียนไว้ มึงไปอ่านเองได้"
        },
        {
          "tag": "CURIOSITY-5",
          "t0": 114.22,
          "t1": 117.74,
          "text": "โบรกที่ยังไหวอยู่จริง จะไม่ปล่อยให้เว็บหายไปเงียบๆแบบนี้"
        },
        {
          "tag": "SUMMARY-1",
          "t0": 118.2,
          "t1": 119.32,
          "text": "สรุปแบบไม่โลกสวย"
        },
        {
          "tag": "SUMMARY-2",
          "t0": 119.76,
          "t1": 125.02,
          "text": "เว็บหาย ไม่มีใบอนุญาต ไม่มีหน่วยงานคุ้มครอง สามอย่างนี้ไม่ใช่เรื่องบังเอิญ"
        },
        {
          "tag": "SUMMARY-3",
          "t0": 125.4,
          "t1": 128.96,
          "text": "ก่อนฝากเงินโบรกไหนก็ตาม เช็กสามอย่างแบบที่กูทำให้ดูวันนี้"
        },
        {
          "tag": "SUMMARY-4",
          "t0": 129.38,
          "t1": 132.88,
          "text": "หนึ่ง เข้าเว็บโบรกตรงๆตอนนี้เลย ยังเปิดอยู่จริงไหม"
        },
        {
          "tag": "SUMMARY-5",
          "t0": 133.52,
          "t1": 137.26,
          "text": "สอง เช็กชื่อเว็บที่เว็บตรวจสอบฟรีๆ ยังมีเจ้าของอยู่ไหม"
        },
        {
          "tag": "SUMMARY-6",
          "t0": 137.86,
          "t1": 141.02,
          "text": "สาม เข้าวิกิเอฟเอ็กซ์ เช็กว่ามีใบอนุญาตจริงไหม"
        },
        {
          "tag": "SUMMARY-7",
          "t0": 141.48,
          "t1": 145.64,
          "text": "กูไม่ได้แนะนำให้ใช้หรือเลิกใช้เจ้าไหน กูแค่ชี้วิธีเช็กให้เป็น"
        }
      ]
    },
    {
      "id": "seg05",
      "t0": 145.9,
      "t1": 153.0333,
      "frame_count": 214,
      "lines": [
        {
          "tag": "SUMMARY-8",
          "t0": 146.08,
          "t1": 150.5,
          "text": "คอมเมนต์คำว่า เช็กเว็บโบรก ถ้ามึงอยากได้ขั้นตอนเช็กเว็บและใบอนุญาตเอง"
        },
        {
          "tag": "SUMMARY-9",
          "t0": 150.8,
          "t1": 152.64,
          "text": "อย่าปล่อยให้เว็บหายไปพร้อมเงินมึง"
        }
      ]
    }
  ]
}
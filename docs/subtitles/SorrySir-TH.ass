Dialogue: 0,0:00:09.48,0:00:11.70,TH,,0,0,,ผมทำรูปหล่นครับ
Dialogue: 0,0:00:33.57,0:00:36.20,TH,,0,0,,เช้าวันนั้นผมเข้างานเร็วกว่าปกติ
Dialogue: 0,0:00:36.50,0:00:38.85,TH,,0,0,,รูปมันเอียงอยู่นิดเดียวเอง
Dialogue: 0,0:00:38.90,0:00:41.16,TH,,0,0,,ผมก็เลยจัดให้มันตรง
Dialogue: 0,0:00:42.52,0:00:45.30,TH,,0,0,,แล้ว... ก็อย่างที่เห็นครับ
Dialogue: 0,0:00:45.41,0:00:47.00,TH,,0,0,,มันหลุดจากผนัง
Dialogue: 0,0:00:47.05,0:00:48.54,TH,,0,0,,ตรงนั้นก็เลยเป็นรูอยู่
Dialogue: 0,0:00:48.60,0:00:51.50,TH,,0,0,,ผมโทรเรียกช่างฉาบมาอุดให้ทันที
Dialogue: 0,0:00:51.55,0:00:52.94,TH,,0,0,,ใช่ร้านช่างไหมครับ
Dialogue: 0,0:00:53.00,0:00:54.14,TH,,0,0,,ใช่ครับ มีอะไรให้ช่วย
Dialogue: 0,0:00:54.24,0:00:55.60,TH,,0,0,,มาตอนนี้เลยได้ไหมครับ
Dialogue: 0,0:00:56.30,0:00:57.50,TH,,0,0,,ด่วนขนาดนั้นเลยเหรอ
Dialogue: 0,0:00:57.62,0:00:58.90,TH,,0,0,,ขอร้องครับ
Dialogue: 0,0:01:01.62,0:01:06.30,TH,,0,0,,อรุณสวัสดิ์ครับ เดอะ วัลเดอร์ คอลเลกชัน\Nจะเปิดให้เข้าชมในอีกห้านาที
Dialogue: 0,0:01:06.76,0:01:10.00,TH,,0,0,,แล้วลูกค้าคนแรก\Nก็เดินเข้ามาในห้องนี้
Dialogue: 0,0:01:19.19,0:01:21.00,TH,,0,0,,ขอโทษนะครับท่าน
Dialogue: 0,0:01:23.34,0:01:25.30,TH,,0,0,,ผนังนั่นเป็นอะไร
Dialogue: 0,0:01:25.40,0:01:27.20,TH,,0,0,,ขอโทษครับท่าน
Dialogue: 0,0:01:30.39,0:01:33.80,TH,,0,0,,นั่นคือศิลปะ ผมชอบ
Dialogue: 0,0:01:35.40,0:01:38.37,TH,,0,0,,ดูอะไรกันอยู่\Nตรงนั้นมันไม่มีอะไรเลย
Dialogue: 0,0:01:38.42,0:01:40.80,TH,,0,0,,ฉันกำลังดูงานศิลปะ
Dialogue: 0,0:01:41.66,0:01:43.95,TH,,0,0,,มันพูดถึงชนชั้นแรงงานชัด ๆ
Dialogue: 0,0:01:43.98,0:01:44.78,TH,,0,0,,มันคือรอยแตก
Dialogue: 0,0:01:44.80,0:01:47.02,TH,,0,0,,นั่นแหละที่เขาอยากให้คุณคิด
Dialogue: 0,0:01:47.07,0:01:48.80,TH,,0,0,,มันทำให้ยายนึกถึงแม่
Dialogue: 0,0:01:48.85,0:01:49.82,TH,,0,0,,อย่าไปแตะ
Dialogue: 0,0:01:50.40,0:01:51.40,TH,,0,0,,หนูแค่วัดขนาด
Dialogue: 0,0:01:51.44,0:01:52.70,TH,,0,0,,เราจะสายแล้วนะ
Dialogue: 0,0:01:58.10,0:01:59.51,TH,,0,0,,อรุณสวัสดิ์ครับ
Dialogue: 0,0:01:59.56,0:02:02.60,TH,,0,0,,ยินดีต้อนรับทุกท่าน\Nสู่เดอะ วัลเดอร์ คอลเลกชัน
Dialogue: 0,0:02:02.64,0:02:05.50,TH,,0,0,,คุณวัลเดอร์จะลงมาในอีกสักครู่ครับ
Dialogue: 0,0:02:05.65,0:02:07.35,TH,,0,0,,ยายขอซื้อชิ้นนี้
Dialogue: 0,0:02:07.63,0:02:09.20,TH,,0,0,,สองล้าน
Dialogue: 0,0:02:09.88,0:02:11.60,TH,,0,0,,ได้ครับคุณยาย ได้ครับ
Dialogue: 0,0:02:12.16,0:02:14.40,TH,,0,0,,ผมจะไปตามคุณวัลเดอร์เดี๋ยวนี้
Dialogue: 0,0:02:30.91,0:02:32.30,TH,,0,0,,ห้าล้าน
Dialogue: 0,0:02:32.46,0:02:35.10,TH,,0,0,,ผมให้ห้าล้านสำหรับชิ้นนี้
Dialogue: 0,0:02:39.16,0:02:41.10,TH,,0,0,,ขออภัยครับท่าน\Nขอทราบชื่อได้ไหมครับ
Dialogue: 0,0:02:41.22,0:02:43.50,TH,,0,0,,แคร์ริงตัน
Dialogue: 0,0:02:45.00,0:02:47.60,TH,,0,0,,คุณแคร์ริงตัน ครับผม
Dialogue: 0,0:02:48.30,0:02:50.70,TH,,0,0,,ท่านไม่ได้แจ้งล่วงหน้าว่าจะมา
Dialogue: 0,0:02:50.76,0:02:52.95,TH,,0,0,,ไม่งั้นผมจะได้ต้อนรับให้สมเกียรติ
Dialogue: 0,0:02:53.08,0:02:55.40,TH,,0,0,,ผมจะติดต่อคุณวัลเดอร์เดี๋ยวนี้ครับ
Dialogue: 0,0:03:07.83,0:03:10.05,TH,,0,0,,อรุณสวัสดิ์ อรุณสวัสดิ์ทุกคน
Dialogue: 0,0:03:10.11,0:03:11.90,TH,,0,0,,วันนี้เป็นวันที่ดีมาก
Dialogue: 0,0:03:12.06,0:03:14.20,TH,,0,0,,อ้าว คุณแคร์ริงตัน อยู่นี่เอง
Dialogue: 0,0:03:14.25,0:03:16.15,TH,,0,0,,ไม่บอกผมเลยว่าจะมา
Dialogue: 0,0:03:16.20,0:03:17.79,TH,,0,0,,ผมจะได้ต้อนรับให้สมเกียรติ
Dialogue: 0,0:03:17.84,0:03:19.57,TH,,0,0,,ห้องนี้เพิ่งจัดใหม่
Dialogue: 0,0:03:19.62,0:03:21.65,TH,,0,0,,มาสิ ผมจะพาดูให้หมด
Dialogue: 0,0:03:21.70,0:03:25.39,TH,,0,0,,ปีกนี้เพิ่งแขวนใหม่ทั้งหมด\Nเมื่ออาทิตย์ที่แล้วเอง
Dialogue: 0,0:03:25.44,0:03:28.09,TH,,0,0,,ผมว่าคุณต้องชอบสิ่งที่ผมทำ
Dialogue: 0,0:03:28.14,0:03:30.61,TH,,0,0,,ได้มาทั้งหมดในช่วงสองปีนี้
Dialogue: 0,0:03:30.66,0:03:33.20,TH,,0,0,,แต่ผมเก็บชิ้นที่ดีที่สุดไว้ให้คุณ
Dialogue: 0,0:03:33.90,0:03:37.22,TH,,0,0,,เก้าอี้ตัวนี้อยู่ในห้อง\Nตอนเซ็นสนธิสัญญาสงบศึก
Dialogue: 0,0:03:37.27,0:03:41.52,TH,,0,0,,ไม่ได้อยู่ที่โต๊ะ อยู่ตรงมุมห้อง\Nไม่มีใครนั่งมันเลย
Dialogue: 0,0:03:41.57,0:03:45.00,TH,,0,0,,ลอบดักปลา\Nสี่สิบปีไม่เคยดักอะไรได้เลย
Dialogue: 0,0:03:45.05,0:03:48.04,TH,,0,0,,คนที่ทำมันขึ้นมา\Nขายไม่ได้สักอันเดียว
Dialogue: 0,0:03:48.19,0:03:51.60,TH,,0,0,,ขอโทษนะ คุณตามเรามาด้วยไอ้นั่นเหรอ
Dialogue: 0,0:04:02.10,0:04:03.50,TH,,0,0,,แล้วก็ชิ้นนี้
Dialogue: 0,0:04:04.54,0:04:08.00,TH,,0,0,,ผมไม่ได้สั่งทำ\Nผมไม่ได้ซื้อมา
Dialogue: 0,0:04:09.30,0:04:13.00,TH,,0,0,,มันเกิดขึ้นกับผนังของผม\Nตอนที่ไม่มีใครมอง
Dialogue: 0,0:04:13.05,0:04:16.60,TH,,0,0,,ชิ้นนั้นตัดสินใจด้วยตัวมันเอง
Dialogue: 0,0:04:16.69,0:04:23.10,TH,,0,0,,ผมสะสมงานศิลปะมาสี่สิบปี เพื่อหาอะไรสักอย่าง\Nศิลปะไม่ต้องการผม
Dialogue: 0,0:04:23.30,0:04:25.70,TH,,0,0,,คุณวัลเดอร์ ผมต้องการมัน
Dialogue: 0,0:04:25.78,0:04:29.30,TH,,0,0,,แน่นอนอยู่แล้ว ใคร ๆ ก็ต้องการ
Dialogue: 0,0:04:41.32,0:04:44.20,TH,,0,0,,มาแล้ว ในที่สุด
Dialogue: 0,0:04:46.40,0:04:48.30,TH,,0,0,,สิบล้าน
Dialogue: 0,0:04:49.26,0:04:51.30,TH,,0,0,,สิบห้า
Dialogue: 0,0:04:52.36,0:04:54.30,TH,,0,0,,ยี่สิบล้าน
Dialogue: 0,0:04:55.04,0:04:57.20,TH,,0,0,,ยี่สิบห้า
Dialogue: 0,0:04:58.50,0:05:00.60,TH,,0,0,,ห้าสิบ
Dialogue: 0,0:05:10.90,0:05:13.20,TH,,0,0,,หนึ่งร้อยล้าน
Dialogue: 0,0:05:24.08,0:05:27.80,TH,,0,0,,หนึ่งร้อยล้านดอลลาร์\Nสำหรับรอยแตกบนผนัง
Dialogue: 0,0:05:28.32,0:05:32.30,TH,,0,0,,นักสะสม แม็กซิมิเลียน วัลเดอร์\Nปฏิเสธที่จะให้ความเห็น
Dialogue: 0,0:05:44.30,0:05:46.80,TH,,0,0,,รู้ไหมว่าเมื่อกี้จะทำอะไรลงไป
Dialogue: 0,0:05:46.90,0:05:48.40,TH,,0,0,,อุดรอยแตกครับท่าน
Dialogue: 0,0:05:48.48,0:05:49.60,TH,,0,0,,ใช่
Dialogue: 0,0:05:49.88,0:05:51.60,TH,,0,0,,เขาให้ค่าจ้างเท่าไหร่
Dialogue: 0,0:05:51.98,0:05:53.05,TH,,0,0,,แปดร้อยครับ
Dialogue: 0,0:05:53.10,0:05:55.30,TH,,0,0,,ผมจะให้แปดพัน
Dialogue: 0,0:05:55.64,0:05:56.64,TH,,0,0,,ค่าซ่อมเหรอครับ
Dialogue: 0,0:05:56.69,0:05:58.70,TH,,0,0,,อย่ามาที่นี่อีก
Dialogue: 0,0:06:02.71,0:06:04.80,TH,,0,0,,มีคนขอให้ผมมาซ่อมมัน
Dialogue: 0,0:06:13.28,0:06:17.30,TH,,0,0,,หยุดนะ คุณกำลังทำลาย\Nงานศิลปะราคาร้อยล้านดอลลาร์
Dialogue: 0,0:06:18.49,0:06:20.70,TH,,0,0,,ผมนึกว่าเขาจะไล่ผมออก
Dialogue: 0,0:06:35.90,0:06:37.60,TH,,0,0,,ผมเลยต้องทำอะไรสักอย่าง
Dialogue: 0,0:06:39.80,0:06:41.14,TH,,0,0,,ขอโทษครับท่าน
Dialogue: 0,0:06:41.24,0:06:43.30,TH,,0,0,,ผมทำมันแตกเอง เมื่อชั่วโมงที่แล้ว
Dialogue: 0,0:06:45.38,0:06:47.40,TH,,0,0,,ผมทำผนังแตกเองครับท่าน
Dialogue: 0,0:06:47.44,0:06:49.60,TH,,0,0,,ผมจะชดใช้ค่าเสียหายทั้งหมด
Dialogue: 0,0:06:49.75,0:06:50.83,TH,,0,0,,ผมขอโทษครับ
Dialogue: 0,0:06:50.88,0:06:53.60,TH,,0,0,,งั้นศิลปินก็คือตัวอาคาร
Dialogue: 0,0:06:55.22,0:06:57.60,TH,,0,0,,ผมไม่ได้ซื้อรอยแตกบนผนัง
Dialogue: 0,0:06:58.24,0:07:00.40,TH,,0,0,,ผมซื้องานศิลปะ
Dialogue: 0,0:07:04.92,0:07:06.90,TH,,0,0,,หนึ่งร้อยล้าน
Dialogue: 0,0:07:12.18,0:07:13.70,TH,,0,0,,แต่นั่นมันผนังของผมนะ
Dialogue: 0,0:07:13.74,0:07:14.90,TH,,0,0,,ผมต้องได้สิ
Dialogue: 0,0:07:14.92,0:07:16.60,TH,,0,0,,ผมไม่ได้จ่ายค่าผนัง
Dialogue: 0,0:07:16.80,0:07:19.60,TH,,0,0,,ผมจ่ายให้ศิลปินที่สร้างมันขึ้นมา
Dialogue: 0,0:07:29.60,0:07:32.90,TH,,0,0,,อรุณสวัสดิ์ครับ\Nพิพิธภัณฑ์เปิดให้เข้าชมแล้ว
Dialogue: 0,0:07:56.10,0:07:59.60,TH,,0,0,,นั่นคือศิลปะ ผมชอบ

# Reference copy — generated on the box by scripts/console-deploy.sh (`cert`
# stage). Installed at /etc/systemd/system/mooniex-console-cert-renew.timer.
#
# Weekly is plenty for a ~90-day cert; tailscale cert only actually reissues
# when the current cert is near expiry, so most runs are cheap no-ops.
[Unit]
Description=Weekly renewal check for the MoonieX Console tailscale TLS cert

[Timer]
OnCalendar=weekly
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target

# Reference copy — the authoritative version is generated on the box by
# scripts/console-deploy.sh (the `service` stage). Edit the script, not this,
# unless you're only reading it for reference. Installed at
# /etc/systemd/system/mooniex-console.service on Contabo.
#
# MoonieX Console — Tailscale-only mobile web console.
# Binds ONLY to the tailnet interface IP; nothing listens on the public
# interface. HTTPS via a tailscale-issued Let's Encrypt cert.
[Unit]
Description=MoonieX Console (mobile iTerm2 web console, tailnet-only)
# Needs the tailnet IP to exist before it can bind to it.
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=simple
WorkingDirectory=/opt/mooniex-console
# Isolated Node 22 (system node is 20.x, too old for node:sqlite >= 22.5).
ExecStart=/opt/node-v22/bin/node src/server.js
# App loads its own /opt/mooniex-console/.env via node's process.loadEnvFile.
Restart=on-failure
RestartSec=3
# Wait for the tailnet IP to exist before attempting the bind (cold boot).
ExecStartPre=/bin/sh -c 'until /usr/bin/tailscale ip -4 >/dev/null 2>&1; do sleep 1; done'
User=root
Group=root

[Install]
WantedBy=multi-user.target

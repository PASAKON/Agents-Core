# Copy to .env for local dev: cp .env.example .env

# HTTP port the console listens on
PORT=4300

# WebAuthn relying party config — for local dev, RP ID must match the
# hostname you open in the browser exactly (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MoonieX Console
WEBAUTHN_ORIGIN=http://localhost:4300

# HMAC secret used to sign the mx_console session cookie. Generate a real
# random value for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-secret-change-me

# SQLite file for operators/credentials (own DB, not shared with webapp)
DB_PATH=./data/console.db

# Repo root the tmux sessions run from (defaults to one level up from
# console/, i.e. the Agents repo root where runners/ lives)
ORG_ROOT=..

# Python interpreter used to launch agent chat REPLs inside tmux.
# Defaults to <ORG_ROOT>/.venv/bin/python if present, else `python3`.
# PYTHON_BIN=/path/to/.venv/bin/python

# Set to "true" only when served over HTTPS (adds Secure to the cookie).
# Leave false for local http://localhost dev.
COOKIE_SECURE=false

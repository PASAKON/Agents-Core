[Unit]
Description=Claude usage monitor — poll usage + warm-up reminders (CEO)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/claude-usage-monitor/monitor.py
# Keep one run from overrunning the 4-min cadence.
TimeoutStartSec=90
Nice=10

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mooniex.agents-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/gob/MoonieXHQ/Agents/Core/.venv/bin/python</string>
    <string>-m</string>
    <string>runners.watchdog</string>
    <string>--loop</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Branch poller ON: CEO ruling 2026-09-30 (Org Mesh lane C). The
         poller takes only rows this Mac dispatched (W1.5 poller set). -->
    <key>ORG_WATCHDOG_BRANCH_POLL</key>
    <string>1</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/gob/MoonieXHQ/Agents/Core</string>

  <!-- Long-running daemon (was: nohup python -m runners.watchdog --loop,
       which dies on reboot — LungNote todo b16487b0). RunAtLoad starts it
       immediately on login; KeepAlive respawns it if it ever exits/crashes. -->
  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/gob/MoonieXHQ/Agents/Core/state/watchdog.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/gob/MoonieXHQ/Agents/Core/state/watchdog.log</string>
</dict>
</plist>

[Unit]
Description=MoonieX hub join endpoint (Org Mesh W4.3 + W4.5, tools/join_api.py)
# The public side of `hq join`: serves join.sh / join.ps1 and answers accept / sealed.
# docs: tools/join_api.py (module docstring), deploy/join/README.md (install + rollback).
# Installed by the CTO on Contabo after the W4.5 merge, in the order the README gives:
# the proxy container first, then this unit.
#
# Where it listens: the docker0 address (172.17.0.1 by default), never a public one and never
# 0.0.0.0. deploy/join/bind-docker0.sh reads it with `ip -4 -o addr show dev docker0` when the
# service starts and exports JOIN_API_BIND; tools/join_api.py refuses anything outside
# 127.0.0.0/8 and 172.16.0.0/12. The socat container org-join-proxy
# (deploy/join/docker-compose.join-proxy.yml) forwards traefik's /org-join route to it.
# So 194.233.80.26:8791 answers nothing.
#
# Who it runs as (W4.6c F3): the dedicated system user `org-join`, not `secretary`. The endpoint
# is reachable from the internet, so it gets an account of its own that owns nothing, and a
# database role of its own (org_join, deploy/join/org_join_role.sql) that can do what accept and
# sealed do and nothing else.
#
# Secrets: none in this file. The endpoint gets ONE value, ORG_JOIN_DB_URL, from the /org-join
# folder of Agents-Core prod in Infisical, and nothing else of Agents-Core (no ORG_DB_URL, no
# token of any other service). /etc/infisical/contabo.env is root 0600 and stays that way: the
# fetch runs as root, `infisical_setup.py run ... --path /org-join` puts only that folder's values
# into the environment, then setpriv drops to `org-join` before the endpoint starts. The machine
# credential never reaches the `org-join` user, and no permission on /etc/infisical changes.
# A public-facing process does not stay root. setpriv execs, so systemd still supervises the
# endpoint's own pid. HOME is set because setpriv does not reset it.
#
# The door (W4.6c): this unit is NOT enabled and has no [Install] section. It runs only while
# deploy/join/door.sh has opened the door, and door.sh closes it again on a timer (default 30
# minutes). `systemctl start` by hand works and leaves the door open until something stops it.
#
# JOIN_API_PUBLIC_URL is what join.sh is told it came from. JOIN_API_TRUST_FORWARDED=1
# rate-limits on the caller (the last X-Forwarded-For entry, which traefik appends), not on
# the proxy container that is the TCP peer of every request.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# No User= line on purpose: the unit runs as root by default. An explicit User=root together with
#   NoNewPrivileges=yes and a directive that installs a seccomp filter (LockPersonality,
#   ProtectKernelModules) makes systemd clear CAP_SETUID from the effective set before exec, so
#   setpriv fails with "setresuid failed: Operation not permitted" (measured on Contabo,
#   systemd 255, 2026-10-01: CapEff 000001fffffeff7f with User=root, 000001fffffeffff without).
WorkingDirectory=/opt/MoonieXHQ/Agents/Core
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/nonexistent
Environment=JOIN_API_PUBLIC_URL=https://webhook.mooniex.com
Environment=JOIN_API_TRUST_FORWARDED=1
ExecStart=/bin/sh /opt/MoonieXHQ/Agents/Core/deploy/join/bind-docker0.sh /usr/bin/python3 /opt/MoonieXHQ/Agents/Core/tools/infisical_setup.py run Agents-Core prod --as contabo --path /org-join -- /usr/bin/setpriv --reuid=org-join --regid=org-join --init-groups -- /opt/MoonieXHQ/Agents/Core/.venv/bin/python -m tools.join_api --port 8791
Restart=on-failure
RestartSec=10

# Sandbox (Org Mesh W4.6b, security review task-79219f24 F3, the part that changes no secret and
# no database role). The service runs two legs: a root leg (bind-docker0.sh, then
# infisical_setup.py reads /etc/infisical/contabo.env and execs setpriv) and, after setpriv drops
# to `org-join`, the public endpoint. The directives below confine both. What the service
# really writes, found in the code: nothing on disk. The hub is Postgres over the network
# (lib/db.py takes the SQLite path only when no database URL is set; the unit always has
# ORG_JOIN_DB_URL, because `infisical_setup.py run` refuses to start on an empty /org-join folder),
# logs go to stderr and so to journald, /etc/infisical and the checkout are only read, and
# `ip -4 addr show` is a netlink read. Python's attempt to write .pyc files into the checkout
# fails quietly, as it does for any read-only tree. So there is no ReadWritePaths= line on
# purpose: add one only together with the code that needs it.
#
# NoNewPrivileges: no process of this unit can gain privilege through exec (setuid or setgid
#   bit, file capabilities). setpriv only DROPS root to `org-join`, which this does not block.
NoNewPrivileges=yes
# ProtectSystem=strict: the whole file system is read-only for this unit, except /dev, /proc and
#   /sys (which the next directives cover). A bug in the endpoint cannot rewrite the checkout
#   (F15: the scripts it serves are in it) or anything under /etc.
ProtectSystem=strict
# ProtectHome: /home, /root and /run/user are empty and unreachable, so the endpoint cannot read
#   another user's keys or shell history. Nothing needs them: the checkout is under /opt, and
#   Environment=HOME above names a directory that does not exist, for setpriv to pass on.
#   Before installing, check that
#   `readlink -f /opt/MoonieXHQ/Agents/Core/.venv/bin/python` does not resolve under /home or /root
#   (an interpreter installed there would stop working). lib/config.py already treats an
#   unreadable node.yaml as absent on the path join_api uses (config.hosts()).
ProtectHome=yes
# PrivateTmp: its own /tmp and /var/tmp, shared with no other service. The endpoint uses no
#   temporary file.
PrivateTmp=yes
# ProtectKernelTunables: /proc/sys, /sys and the like are read-only. `ip` only reads them.
ProtectKernelTunables=yes
# ProtectKernelModules: no kernel module can be loaded, even by the root leg.
ProtectKernelModules=yes
# ProtectControlGroups: the cgroup file system is read-only.
ProtectControlGroups=yes
# RestrictSUIDSGID: nothing this unit creates can carry a setuid or setgid bit.
RestrictSUIDSGID=yes
# LockPersonality: the execution domain (personality(2)) cannot be changed.
LockPersonality=yes

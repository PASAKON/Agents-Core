+def validate_steward(body: dict) -> dict | None:
+    if 'steward' not in body:
+        return None
+    value = body['steward']
+    if not isinstance(value, dict) or set(value) != {'band', 'tick_at', 'actions'}:
+        raise ValueError('invalid steward object')
+    if not isinstance(value['band'], str) or not 1 <= len(value['band']) <= 10:
+        raise ValueError('invalid steward band')
+    tick = value['tick_at']
+    if not isinstance(tick, str) or not 1 <= len(tick) <= 40 or 'T' not in tick:
+        raise ValueError('invalid steward tick_at')
+    try:
+        datetime.fromisoformat(tick.replace('Z', '+00:00'))
+    except ValueError:
+        raise ValueError('invalid steward tick_at') from None
+    if type(value['actions']) is not int or value['actions'] < 0:
+        raise ValueError('invalid steward actions')
+    return dict(value)
+

[Unit]
Description=MoonieX tool-value weekly report to SomPong (plan 2026-10-13 T2)
# Builds the report from the hub rows and sends one letter to SomPong (COO),
# who takes it to the CEO (docs/plans/tool-value-weekly-and-enforcement-2026-10-13.md
# §3.3). A host with no row reads "ไม่มีข้อมูล", never a guess. Started by
# tool-value-report.timer, not directly. After= the collect, so a Persistent catch-up
# at boot, which starts both, collects first.
#
# The code runs from a pinned deploy worktree, worktrees/tool-value-deploy, checked
# out detached at the origin/main sha the gate landed. Contabo's local main is held
# (a60f1744) and has no tools/tool_value.py. ORG_ROOT points every data path (state/,
# ledgers, mailbox) at the live checkout, and the letter goes through that checkout's
# own tools/send_to_cxo.py. Once local main carries tool_value.py, point ExecStart at
# /opt/MoonieXHQ/Agents/Core/tools/tool_value.py and remove the worktree
# (docs/ops/tool-value-timers.md).
#
# ORG_DB_URL comes from scripts/hub/with-org-db-env.sh (this host's Infisical
# identity), not from an EnvironmentFile. Without it lib.db lands on the archived
# state/tasks.db and raises ArchivedDB, so the run fails and logs the error.
After=network-online.target docker.service tool-value-collect.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=ORG_ROOT=/opt/MoonieXHQ/Agents/Core
WorkingDirectory=/opt/MoonieXHQ/Agents/Core
Nice=10
MemoryMax=300M
TimeoutStartSec=15min
ExecStart=/bin/bash /opt/MoonieXHQ/Agents/Core/scripts/hub/with-org-db-env.sh /opt/MoonieXHQ/Agents/Core/.venv/bin/python /opt/MoonieXHQ/Agents/Core/worktrees/tool-value-deploy/tools/tool_value.py report

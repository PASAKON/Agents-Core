[Unit]
Description=Run org-worktree-reap.service every 6 hours (00:30, 06:30, 12:30, 18:30 Bangkok time)
# The time zone sits in the calendar spec, so the Contabo clock (CEST until 25 Oct,
# then CET) needs no +5/+6 h arithmetic. Persistent: a run missed while the box was
# down fires once on the next boot.

[Timer]
OnCalendar=*-*-* 00/6:30:00 Asia/Bangkok
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target

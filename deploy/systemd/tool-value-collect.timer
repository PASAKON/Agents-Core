[Unit]
Description=Run tool-value-collect.service every Monday 07:30 Bangkok time
# The time zone sits in the calendar spec, so the Contabo clock
# (CEST until 25 Oct, then CET) needs no +5/+6 h arithmetic.

[Timer]
OnCalendar=Mon *-*-* 07:30:00 Asia/Bangkok
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target

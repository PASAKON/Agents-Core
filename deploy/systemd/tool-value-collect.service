[Unit]
Description=MoonieX tool-value weekly collect (plan 2026-10-13 T2)
# Writes this host's tool-value row for the week to the hub
# (docs/plans/tool-value-weekly-and-enforcement-2026-10-13.md §3.3). Triggered
# by tool-value-collect.timer, not started directly.
#
# ORG_DB_URL comes from scripts/hub/with-org-db-env.sh, not an
# EnvironmentFile: Contabo's /root/.config/mooniex/org-db.env carries only
# POSTGRES_*, so the URL is read through this host's Infisical identity
# (wrapper leg b). With EnvironmentFile alone the collect no-ops as
# "hub not configured".
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/MoonieXHQ/Agents/Core
Nice=10
MemoryMax=300M
TimeoutStartSec=15min
ExecStart=/bin/bash /opt/MoonieXHQ/Agents/Core/scripts/hub/with-org-db-env.sh /opt/MoonieXHQ/Agents/Core/.venv/bin/python /opt/MoonieXHQ/Agents/Core/tools/tool_value.py collect

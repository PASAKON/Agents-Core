[Unit]
Description=Recover Postgres listener after tailnet address is ready
After=tailscaled.service docker.service
Wants=tailscaled.service docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/MoonieXHQ/Agents/Core/scripts/org-postgres-tailnet.sh
TimeoutStartSec=6min

[Install]
WantedBy=multi-user.target

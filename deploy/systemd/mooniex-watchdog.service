[Unit]
Description=MoonieX org watchdog (Org Mesh W0.4)
# runners.watchdog --loop is a long-running daemon (it sleeps INTERVAL_S between
# scans itself), so this is a plain service with Restart=, not a oneshot with a
# timer -- same shape as the Mac's scripts/com.mooniex.agents-watchdog.plist.
# Files only -- installing this unit is a later live step (W0.5).
#
# ORG_WATCHDOG_BRANCH_POLL is deliberately NOT set: the branch poller stays off
# until the CEO rules on it (runners/watchdog.py, fifth pass). Do not add it
# here without that ruling.
#
# No secrets in this unit. ORG_DB_URL for the Postgres hub arrives with W1.6,
# through an EnvironmentFile, not by editing this file.
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/MoonieXHQ/Agents/Core
Environment=ORG_HOST=contabo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/MoonieXHQ/Agents/Core/.venv/bin/python -m runners.watchdog --loop
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

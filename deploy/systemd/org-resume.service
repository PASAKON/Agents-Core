[Unit]
Description=Resume sessions after a prepared Contabo restart
ConditionPathExists=/opt/MoonieXHQ/Agents/Core/state/restart/pending-contabo.json
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/MoonieXHQ/Agents/Core
Environment=TMUX_TMPDIR=/tmp
EnvironmentFile=-/etc/mooniex/org-resume.env
ExecStart=/bin/bash /opt/MoonieXHQ/Agents/Core/scripts/org-resume.sh
KillMode=process
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target

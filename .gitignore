.venv/
__pycache__/
*.pyc
state/tasks.db
state/tasks.db-journal
state/tasks.db-wal
state/tasks.db-shm
state/session-diagrams/
state/logs/*.log
state/logs/*_latest.log
state/locks/*.lock
state/locks/*.log
state/locks/*.winid
state/locks/*-active
TASK.md
state/reports/*
state/.cto_log_pos
state/.cto_log_pos-*
state/org.db
state/orphan-dev-replies-*.log
state/skill-usage.log
state/tab-titles/
state/web-designer/
# SomPong runtime, written whenever the secretary runs on this machine
# (scripts/sompong-mac.sh). The api-key file is a secret and must never be
# committed; the rest is per-machine state that could only ever conflict.
state/secretary-api-key
state/secretary-*.out
state/secretary-telegram-offset.json
state/secretary_waker/
state/browser-guard/
state/locks/*.topic
state/locks/*.tty
state/locks/*.watcher-pid
state/locks/*.pid
state/locks/*.pid.spawnlock
state/locks/*.uuid
state/locks/close-refusals.log
state/locks/*.run
# Ownership sidecar written by tools/send_to_cxo.record_spawn() — records which
# session spawned a C-level, so reply routing resolves from recorded ownership
# rather than from a forgeable message envelope. Runtime state, per-session.
state/locks/*.spawned_by
# Org mailbox (lib/mailbox.py) — one box per live session, drained by
# scripts/hook-inbox.py. Letters are in-flight runtime state, never content.
state/inbox/
state/backups/
state/skill-curator-backups/
# Decision ledger (lib/decision_ledger.py, tools/decide.py) — append-only
# JSONL runtime state, one file per calendar month. Never source.
state/decisions/
# Per-session turn counter for scripts/hook-memory-nudge.py (ADR 0019 §1).
# Runtime state; state/*.db already covers the search index beside it.
state/session-nudge-counters.json
state/watchdog.log
state/*.db
state/fomo-scanner.db-journal
state/fomo-scanner.db-wal
state/fomo-scanner.db-shm
# Claude Code project config: skills/ and settings.json are shared, trackable.
# Only local/secret state is ignored (see .agents/README.md for the .agents/ note).
.claude/settings.local.json
.claude/settings.local.json.bak-*
# Timestamped backups written before a hook-registration change.
.claude/settings.json.bak-*
.claude/scheduled_tasks.lock

# `npx skills add` install target — vendored skill copies, not source.
# Ignore contents but keep the provenance note trackable (a bare `.agents/`
# would exclude the directory itself, and git can't re-include a file whose
# parent directory is excluded).
.agents/*
!.agents/README.md
worktrees/
# Cloned third-party skill sources — each carries its own .git, so they are
# other repos living inside this tree, not content of it. Skills are consumed
# via symlinks from ~/.claude/skills into here.
external/
.env
.DS_Store
demo-api/
utils/

# TraderMindset: runtime-generated posters + unit-test proof artifacts
output/trader-mindset/round-*/
output/trader-mindset/_test/

# Generated media under output/ — deliverables, not source.
# Committing them once produced a 2.69 GB staged tree (405 PNG + 86 MP4) that
# GitHub refused with `RPC failed; HTTP 500` (2026-08-13). Binaries also stay
# in history forever even after deletion, so they are kept out entirely.
# Text deliverables under output/ (md, json, txt) remain tracked.
output/**/*.mp4
output/**/*.mov
output/**/*.webm
output/**/*.png
output/**/*.jpg
output/**/*.jpeg
output/**/*.gif
output/**/*.mp3
output/**/*.wav

# Same rule for render output that lands beside its generator script.
scripts/**/out/*.mp4
scripts/**/out/*.mov
scripts/**/out/*.webm

# scripts/previz-check.py output — regenerate with the script, don't commit.
docs/reports/previz-contacts/

# local model/tool cache — 141MB, never commit
.cache/

# winbox remote-worker runtime artifacts (written at the repo root by the spawn path;
# not source, and they block merge_task for every session while they sit untracked)
.launch/
.worker.json
WORKER.md

# dependency + tool caches that landed at the repo root (34 MB of node_modules,
# pytest scratch) - not source, and they make every git status unreadable
mcp/node_modules/
.pytest_cache/

# reel-editor-th lives in .claude/skills/ (ADR 0027) but its venv is rebuilt from
# requirements.txt by scripts/install-claude-home.sh and its 210 MB b-roll is
# media -> Assets/ + Drive (gdrive-filing), never git.
.claude/skills/reel-editor-th/.venv/
.claude/skills/reel-editor-th/assets/
# one-time migration manifests (rollback input), machine-local
state/claude-home-migration-*.json

state/logs/*_latest.log
state/locks/*.lock
state/locks/*.log
state/locks/*.winid
state/locks/*-active
TASK.md
state/reports/*
state/.cto_log_pos
state/.cto_log_pos-*
state/org.db
state/orphan-dev-replies-*.log
state/skill-usage.log
state/tab-titles/
state/web-designer/
state/browser-guard/
state/locks/*.topic
state/locks/*.tty

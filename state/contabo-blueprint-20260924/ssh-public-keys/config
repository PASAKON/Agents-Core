
Host github.com
  IdentityFile ~/.ssh/id_github
  IdentitiesOnly yes

Host winbox
    HostName 100.124.196.11   # window-gob.tail400676.ts.net, reset 2026-09-24 (was 100.123.83.75 desktop-3nqb2qo)
    User passg
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
    StrictHostKeyChecking accept-new
    # multiplex: every rclone_via_winbox.sh call reuses one TCP+auth session (drive_leg.py makes 4+ calls per object; measured ~2 min per day-tar without it, 2026-09-24)
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h-%p
    ControlPersist 10m

Host github.com-agents-memory
  HostName github.com
  User git
  IdentityFile /root/.ssh/agents_memory_deploy
  IdentitiesOnly yes

[Unit]
Description=MoonieX Secretary (Claude Code shim for the Telegram bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secretary
Group=secretary
WorkingDirectory=/opt/MoonieXHQ/Agents/Core
EnvironmentFile=/home/secretary/.secretary.env
EnvironmentFile=/etc/mooniex/secretary-secrets.env
ExecStart=/usr/bin/python3 /opt/MoonieXHQ/Agents/Core/runners/secretary_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

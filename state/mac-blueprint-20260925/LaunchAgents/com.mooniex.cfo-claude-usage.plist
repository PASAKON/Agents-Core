<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mooniex.cfo-claude-usage</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/gob/MoonieXHQ/Agents/Core/scripts/cfo-claude-usage-feed.sh</string>
	</array>
	<!-- Daily 06:30 local (ICT) — ก่อน cfo-rollup cron 00:05 UTC = 07:05 ICT -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/cfo-claude-usage.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/cfo-claude-usage.err</string>
</dict>
</plist>
